import pyttsx3
import speech_recognition as sr

def test_tts():
    engine = pyttsx3.init()
    engine.say("AI Voice Bot system check successful.")
    engine.runAndWait()
    print("TTS Working ✅")

def test_stt():
    recognizer = sr.Recognizer()
    with sr.Microphone() as source:
        print("Speak something...")
        audio = recognizer.listen(source)
        try:
            text = recognizer.recognize_google(audio)
            print("You said:", text)
            print("STT Working ✅")
        except:
            print("STT Failed ❌")

if __name__ == "__main__":
    test_tts()
    test_stt()
